# WindIntel Platform — Environment Configuration

# Backend Configuration
APP_NAME=WindIntel
ENV=development
DEBUG=false
PORT=8000

# Upstream Elexon BMRS API
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
REQUEST_TIMEOUT_SECONDS=25.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=0.5

# Decision Model
DEFAULT_DECISION_CUTOFF=12:00:00
MARKET_TIMEZONE=Europe/London
GENERATION_UNIT=MW

# Supported Evaluation Period (January 2026)
DATA_START_DATE=2026-01-01
DATA_END_DATE=2026-01-31

# Persistent Caching
CACHE_DB_PATH=windintel.db
CACHE_TTL_SECONDS=2592000

# CORS Origins (JSON formatted array of authorized origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration (Vite environment variables)
# In production, set to your deployed backend URL:
# VITE_API_BASE_URL=https://windintel-api.onrender.com
VITE_API_BASE_URL=http://localhost:8080
